<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎓 EduVerse 5.0</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --primary: #6366f1; --primary-dark: #4f46e5;
  --success: #10b981; --danger: #ef4444; --warning: #f59e0b; --info: #3b82f6;
  --bg: #f0f4f8; --card: #ffffff; --text: #1e293b;
  --text-light: #64748b; --border: #e2e8f0;
  --shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
}
body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--bg); min-height: 100vh; color: var(--text); }

.login-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.login-box { background: white; padding: 40px; border-radius: 20px; box-shadow: var(--shadow-lg); width: 100%; max-width: 420px; }
.logo { font-size: 60px; text-align: center; margin-bottom: 10px; }
h2 { text-align: center; margin-bottom: 5px; font-size: 28px; color: var(--primary); }
.subtitle { text-align: center; color: var(--text-light); margin-bottom: 25px; font-size: 14px; }
.input-group { margin-bottom: 14px; }
.input-group label { display: block; margin-bottom: 5px; font-size: 13px; font-weight: 600; }
input[type="email"], input[type="password"], input[type="text"], input[type="date"], input[type="number"], textarea, select {
  width: 100%; padding: 11px 14px; border: 2px solid var(--border); border-radius: 10px; font-size: 14px; font-family: inherit; background: white;
}
input:focus, textarea:focus, select:focus { outline: none; border-color: var(--primary); }
textarea { resize: vertical; min-height: 80px; }
.btn { width: 100%; padding: 13px; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; margin-bottom: 10px; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
.btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: var(--shadow); }
.btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-primary { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; }
.btn-secondary { background: var(--success); color: white; }
.btn-outline { background: transparent; color: var(--primary); border: 2px solid var(--primary); }
.btn-danger { background: var(--danger); color: white; }
.btn-warning { background: var(--warning); color: white; }
.btn-info { background: var(--info); color: white; }
.btn-small { width: auto; padding: 7px 14px; font-size: 12px; }
.divider { display: flex; align-items: center; margin: 15px 0; color: var(--text-light); font-size: 13px; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
.divider span { padding: 0 15px; }
.hidden { display: none !important; }

.app { display: flex; min-height: 100vh; }
.sidebar { width: 270px; background: white; border-right: 1px solid var(--border); position: fixed; height: 100vh; overflow-y: auto; padding: 20px; z-index: 10; display: flex; flex-direction: column; }
.sidebar-logo { font-size: 22px; font-weight: 700; margin-bottom: 20px; color: var(--primary); display: flex; align-items: center; gap: 8px; }
.class-selector { margin-bottom: 15px; }
.class-selector select { width: 100%; padding: 10px; border: 2px solid var(--border); border-radius: 10px; font-weight: 600; cursor: pointer; }
.class-code-box { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 12px; border-radius: 12px; margin-bottom: 15px; text-align: center; }
.class-code-label { font-size: 10px; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }
.class-code-value { font-size: 24px; font-weight: 900; letter-spacing: 3px; margin-top: 4px; }
.nav-item { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 10px; cursor: pointer; margin-bottom: 3px; transition: all 0.2s; font-size: 14px; font-weight: 500; }
.nav-item:hover { background: var(--bg); }
.nav-item.active { background: rgba(99,102,241,0.1); color: var(--primary); font-weight: 600; }
.nav-item svg { width: 20px; height: 20px; fill: currentColor; }
.nav-badge { margin-left: auto; background: var(--danger); color: white; font-size: 10px; padding: 2px 7px; border-radius: 10px; font-weight: 700; }
.sidebar-profile { margin-top: auto; padding-top: 15px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 15px; overflow: hidden; flex-shrink: 0; }
.avatar img { width: 100%; height: 100%; object-fit: cover; }
.avatar.large { width: 70px; height: 70px; font-size: 28px; }
.avatar.medium { width: 44px; height: 44px; font-size: 18px; }
.avatar.small { width: 30px; height: 30px; font-size: 13px; }
.main-content { flex: 1; margin-left: 270px; padding: 25px; max-width: 1200px; }
.section-title { font-size: 22px; font-weight: 700; margin-bottom: 18px; }

.classes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
.class-card { background: white; border-radius: 14px; padding: 20px; box-shadow: var(--shadow); cursor: pointer; transition: all 0.2s; border: 2px solid transparent; }
.class-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--primary); }
.class-card-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px; }
.class-card-icon { font-size: 36px; }
.class-card-code { background: var(--primary); color: white; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
.class-card-name { font-weight: 700; font-size: 16px; margin-bottom: 4px; }
.create-class-card { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 160px; border: 2px dashed rgba(255,255,255,0.3); }
.create-class-card:hover { border-color: white; }
.create-class-card .plus { font-size: 48px; font-weight: 300; }
.create-class-card .label { font-size: 14px; font-weight: 600; margin-top: 5px; }

.students-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-bottom: 20px; }
.student-card { background: white; border-radius: 12px; padding: 14px; text-align: center; box-shadow: var(--shadow); transition: all 0.2s; border: 2px solid transparent; }
.student-card:hover { transform: translateY(-2px); }
.student-card.teacher { border-color: var(--warning); }
.student-name { font-weight: 600; font-size: 13px; margin: 8px 0 4px; word-break: break-word; }
.student-email { font-size: 10px; color: var(--text-light); margin-bottom: 6px; word-break: break-all; }
.points-badge { background: var(--success); color: white; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; display: inline-block; margin-bottom: 6px; }
.points-badge.negative { background: var(--danger); }
.student-actions { display: flex; justify-content: center; gap: 4px; }
.point-btn { width: 26px; height: 26px; border-radius: 50%; border: none; cursor: pointer; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; color: white; transition: all 0.2s; }
.point-btn.plus { background: var(--success); }
.point-btn.minus { background: var(--danger); }
.point-btn:hover { transform: scale(1.15); }

.chat-container { background: white; border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; display: flex; flex-direction: column; height: 550px; }
.chat-header { padding: 15px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.chat-messages { flex: 1; overflow-y: auto; padding: 15px; background: var(--bg); }
.message { display: flex; gap: 8px; margin-bottom: 12px; animation: fadeIn 0.3s; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.message.own { flex-direction: row-reverse; }
.message-content { max-width: 70%; }
.message-author { font-size: 11px; font-weight: 600; color: var(--text-light); margin-bottom: 2px; }
.message.own .message-author { text-align: right; }
.message-bubble { background: white; padding: 9px 12px; border-radius: 11px; box-shadow: var(--shadow); font-size: 13px; line-height: 1.4; word-break: break-word; }
.message.own .message-bubble { background: var(--primary); color: white; }
.message-time { font-size: 10px; color: var(--text-light); margin-top: 2px; }
.message.own .message-time { text-align: right; }
.chat-input-container { padding: 12px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
.chat-input { flex: 1; padding: 10px 14px; border: 2px solid var(--border); border-radius: 20px; font-size: 13px; }
.chat-input:focus { outline: none; border-color: var(--primary); }
.btn-send { width: 40px; height: 40px; border-radius: 50%; background: var(--primary); color: white; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.btn-send:hover { transform: scale(1.1); }
.btn-send svg { width: 18px; height: 18px; fill: white; }

.assignment-card { background: white; border-radius: 12px; padding: 18px; margin-bottom: 12px; box-shadow: var(--shadow); border-left: 4px solid var(--primary); }
.assignment-card.overdue { border-left-color: var(--danger); opacity: 0.8; }
.assignment-card.submitted { border-left-color: var(--success); }
.assignment-card.graded { border-left-color: var(--warning); }
.assignment-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px; flex-wrap: wrap; gap: 8px; }
.assignment-title { font-weight: 700; font-size: 16px; }
.assignment-due { font-size: 12px; color: var(--text-light); display: flex; align-items: center; gap: 4px; }
.assignment-due.urgent { color: var(--danger); font-weight: 600; }
.assignment-desc { font-size: 13px; color: var(--text); line-height: 1.5; margin-bottom: 10px; white-space: pre-wrap; }
.assignment-meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; color: var(--text-light); margin-bottom: 10px; }
.assignment-meta span { display: flex; align-items: center; gap: 4px; }
.assignment-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.status-badge { padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
.status-pending { background: #fef3c7; color: #92400e; }
.status-submitted { background: #d1fae5; color: #065f46; }
.status-graded { background: #fef3c7; color: #92400e; }

.material-card { background: white; border-radius: 12px; padding: 14px; margin-bottom: 10px; box-shadow: var(--shadow); display: flex; align-items: center; gap: 12px; }
.material-icon { font-size: 32px; }
.material-info { flex: 1; min-width: 0; }
.material-name { font-weight: 600; font-size: 14px; word-break: break-word; }
.material-size { font-size: 11px; color: var(--text-light); }

.submission-card { background: var(--bg); border-radius: 10px; padding: 12px; margin-bottom: 8px; display: flex; align-items: start; gap: 10px; }
.submission-info { flex: 1; min-width: 0; }
.submission-student { font-weight: 600; font-size: 13px; }
.submission-time { font-size: 11px; color: var(--text-light); }
.grade-input { width: 60px; padding: 5px; border: 2px solid var(--border); border-radius: 6px; text-align: center; font-weight: 700; }

.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
.modal-content { background: white; border-radius: 16px; padding: 25px; width: 100%; max-width: 500px; max-height: 90vh; overflow-y: auto; animation: slideUp 0.3s; }
@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
.modal-content h3 { font-size: 20px; margin-bottom: 15px; }
.modal-buttons { display: flex; gap: 10px; margin-top: 15px; }
.modal-buttons .btn { flex: 1; margin: 0; }

.toast-container { position: fixed; top: 20px; right: 20px; z-index: 2000; }
.toast { background: white; padding: 12px 18px; border-radius: 10px; box-shadow: var(--shadow-lg); margin-bottom: 8px; animation: slideIn 0.3s; border-left: 4px solid var(--primary); font-size: 14px; }
.toast.success { border-left-color: var(--success); }
.toast.error { border-left-color: var(--danger); }
@keyframes slideIn { from { opacity: 0; transform: translateX(100px); } to { opacity: 1; transform: translateX(0); } }

.empty-state { text-align: center; padding: 50px 20px; color: var(--text-light); }
.empty-state .icon { font-size: 50px; margin-bottom: 10px; }
.stats-bar { display: flex; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.stat-card { background: white; padding: 12px 18px; border-radius: 12px; box-shadow: var(--shadow); flex: 1; min-width: 100px; }
.stat-value { font-size: 22px; font-weight: 700; color: var(--primary); }
.stat-label { font-size: 11px; color: var(--text-light); }
.file-upload { border: 2px dashed var(--border); border-radius: 10px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.2s; }
.file-upload:hover { border-color: var(--primary); background: rgba(99,102,241,0.05); }
.file-upload input { display: none; }

.search-result { background: white; border-radius: 10px; padding: 12px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.2s; }
.search-result:hover { background: var(--bg); }
.search-result.selected { border: 2px solid var(--primary); }

@media (max-width: 768px) {
  .sidebar { width: 100%; height: auto; position: relative; }
  .main-content { margin-left: 0; padding: 15px; }
  .app { flex-direction: column; }
  .students-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
}
</style>
</head>
<body>

<div class="toast-container" id="toastContainer"></div>

<!-- LOGIN SCREEN -->
<div id="loginScreen" class="login-container">
  <div class="login-box">
    <div class="logo"></div>
    <h2>EduVerse 5.0</h2>
    <p class="subtitle">Plataforma educativa institucional</p>
    
    <div class="input-group">
      <label>Correo Institucional</label>
      <input type="email" id="loginEmail" placeholder="nombre@eduverse.profe.com o @eduverse.alumno.com">
    </div>
    <div class="input-group">
      <label>Contraseña</label>
      <input type="password" id="loginPassword" placeholder="••••••••">
    </div>
    <button class="btn btn-primary" onclick="handleLogin()">Iniciar Sesión</button>
    
    <div class="divider"><span>¿Eres profesor nuevo?</span></div>
    <button class="btn btn-outline" onclick="handleRegister()">Crear Cuenta de Profesor</button>
    
    <div style="margin-top:15px; padding:12px; background:#eff6ff; border-radius:8px; font-size:12px; color:#1e40af; text-align:center;">
      ℹ️ <strong>Alumnos:</strong> Tu cuenta ya está creada. Inicia sesión con tus credenciales.
    </div>
  </div>
</div>

<!-- MAIN APP -->
<div id="appScreen" class="app hidden">
  <div class="sidebar">
    <div class="sidebar-logo">🎓 EduVerse</div>
    <div id="classSelectorContainer" class="class-selector hidden">
      <label style="font-size:11px;color:var(--text-light);font-weight:600;">MI CLASE</label>
      <select id="classSelector" onchange="switchClass(this.value)"></select>
    </div>
    <div class="class-code-box" id="classCodeBox">
      <div class="class-code-label">Código de Clase</div>
      <div class="class-code-value" id="classCodeDisplay">----</div>
    </div>
    <div id="navItems">
      <div class="nav-item active" onclick="showSection('students', event)"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>Alumnos<span class="nav-badge" id="studentCount">0</span></div>
      <div class="nav-item" onclick="showSection('assignments', event)"><svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg>Tareas<span class="nav-badge hidden" id="taskBadge">0</span></div>
      <div class="nav-item" onclick="showSection('materials', event)"><svg viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/></svg>Materiales</div>
      <div class="nav-item" onclick="showSection('announcements', event)"><svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>Anuncios</div>
      <div class="nav-item" onclick="showSection('chat', event)"><svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>Chat<span class="nav-badge hidden" id="chatBadge">0</span></div>
    </div>
    <div class="sidebar-profile">
      <div class="avatar" id="sidebarAvatar">U</div>
      <div style="flex:1;min-width:0;"><div style="font-weight:600;font-size:13px;" id="sidebarName">Usuario</div><div style="font-size:11px;color:var(--text-light);" id="sidebarRole">Rol</div></div>
      <button class="btn btn-outline btn-small" onclick="logout()">Salir</button>
    </div>
  </div>
  <div class="main-content" id="mainContent"></div>
</div>

<!-- MODALS -->
<div id="createClassModal" class="modal hidden">
  <div class="modal-content">
    <h3>🏫 Crear Nueva Clase</h3>
    <div class="input-group"><label>Nombre de la clase</label><input type="text" id="newClassName" placeholder="Ej: Matemáticas 3º ESO"></div>
    <div class="input-group"><label>Descripción (opcional)</label><textarea id="newClassDesc" placeholder="Descripción breve..."></textarea></div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('createClassModal')">Cancelar</button><button class="btn btn-primary" onclick="createClass()">Crear Clase</button></div>
  </div>
</div>

<div id="addStudentModal" class="modal hidden">
  <div class="modal-content">
    <h3> Añadir Alumno a la Clase</h3>
    <p style="font-size:12px;color:var(--text-light);margin-bottom:15px;">Busca al alumno por su correo institucional. La cuenta ya debe existir en el sistema.</p>
    <div class="input-group"><label>Buscar por correo</label><input type="email" id="searchStudentEmail" placeholder="alumno@eduverse.alumno.com" oninput="searchStudent()"></div>
    <div id="searchResults"></div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('addStudentModal')">Cancelar</button></div>
  </div>
</div>

<div id="createAssignmentModal" class="modal hidden">
  <div class="modal-content">
    <h3>📝 Nueva Tarea</h3>
    <div class="input-group"><label>Título</label><input type="text" id="assignTitle" placeholder="Ej: Ejercicios página 45"></div>
    <div class="input-group"><label>Descripción</label><textarea id="assignDesc" placeholder="Instrucciones..."></textarea></div>
    <div class="input-group"><label>Fecha de entrega</label><input type="date" id="assignDue"></div>
    <div class="input-group"><label>Puntuación máxima</label><input type="number" id="assignMaxPoints" value="100"></div>
    <div class="input-group"><label>Adjuntar archivo</label>
      <label class="file-upload" for="assignFile"><div>📎 Haz clic</div><small id="assignFileName">Ninguno</small></label>
      <input type="file" id="assignFile" onchange="handleAssignFile(event)">
    </div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('createAssignmentModal')">Cancelar</button><button class="btn btn-primary" onclick="createAssignment()">Publicar</button></div>
  </div>
</div>

<div id="submitAssignmentModal" class="modal hidden">
  <div class="modal-content">
    <h3> Entregar Tarea</h3>
    <p id="submitAssignTitle" style="font-weight:600;margin-bottom:10px;"></p>
    <div class="input-group"><label>Respuesta</label><textarea id="submitText" placeholder="Escribe aquí..."></textarea></div>
    <div class="input-group"><label>Adjuntar archivo</label>
      <label class="file-upload" for="submitFile"><div>📎 Haz clic</div><small id="submitFileName">Ninguno</small></label>
      <input type="file" id="submitFile" onchange="handleSubmitFile(event)">
    </div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('submitAssignmentModal')">Cancelar</button><button class="btn btn-primary" onclick="submitAssignment()">Enviar</button></div>
  </div>
</div>

<div id="viewSubmissionsModal" class="modal hidden">
  <div class="modal-content" style="max-width:600px;">
    <h3>📋 Entregas</h3>
    <div id="submissionsList"></div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('viewSubmissionsModal')">Cerrar</button></div>
  </div>
</div>

<div id="uploadMaterialModal" class="modal hidden">
  <div class="modal-content">
    <h3>📚 Subir Material</h3>
    <div class="input-group"><label>Nombre</label><input type="text" id="materialName" placeholder="Ej: Apuntes tema 3"></div>
    <div class="input-group"><label>Archivo</label>
      <label class="file-upload" for="materialFile"><div>📎 Haz clic</div><small id="materialFileName">Ninguno</small></label>
      <input type="file" id="materialFile" onchange="handleMaterialFile(event)">
    </div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('uploadMaterialModal')">Cancelar</button><button class="btn btn-primary" onclick="uploadMaterial()">Subir</button></div>
  </div>
</div>

<div id="announcementModal" class="modal hidden">
  <div class="modal-content">
    <h3>📢 Nuevo Anuncio</h3>
    <div class="input-group"><label>Mensaje</label><textarea id="announcementText" placeholder="Escribe el anuncio..."></textarea></div>
    <div class="modal-buttons"><button class="btn btn-outline" onclick="closeModal('announcementModal')">Cancelar</button><button class="btn btn-primary" onclick="postAnnouncement()">Publicar</button></div>
  </div>
</div>

