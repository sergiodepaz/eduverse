<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore-compat.js"></script>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyBmTBMyE7Y_LgSXH1SrmEv29DLYdxkyUEw",
  authDomain: "compartir-textos-app.firebaseapp.com",
  projectId: "compartir-textos-app",
  storageBucket: "compartir-textos-app.appspot.com",
  messagingSenderId: "705083380628",
  appId: "1:705083380628:web:ce267570e09e3ef1b27581"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();
const IMGBB_API_KEY = '1f58a33d7158e7bd41e026cc849bda16';

let currentUser = null, userData = null, currentClass = null, currentSection = 'students';
let students = [], messages = [], announcements = [], assignments = [], materials = [], submissions = [];
let studentsUnsub = null, messagesUnsub = null, announcementsUnsub = null, assignmentsUnsub = null, materialsUnsub = null;
let unreadMessages = 0, pendingTasks = 0;
let selectedAssignFile = null, selectedSubmitFile = null, selectedMaterialFile = null;
let currentSubmitAssignmentId = null;
let myClasses = [], studentClasses = [];
let allUsersCache = [];

const avatars = ['🦁','🐯','🐻','🐼','🐸','🦊','🐷','🐵','🐔','🐧','🐨','🦄','🐝','🐛','🐞','🐜','🐢','🐍','🐙','🦑','🦀','🐠','🐬','🐳','🐅','🦓','🦏','🐪','🦘','🐂','🐖','🐏','🐐','🐕','🐓','🦃','🦜','🦢','🕊️','🐇','🦡','🦥','🐿️',''];
function getRandomAvatar() { return avatars[Math.floor(Math.random() * avatars.length)]; }
function generateClassCode() { const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let code = ''; for (let i = 0; i < 4; i++) code += c[Math.floor(Math.random() * c.length)]; return code; }

function showToast(msg, type='success') {
  const c = document.getElementById('toastContainer'), t = document.createElement('div');
  t.className = `toast ${type}`; t.textContent = msg; c.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

function checkDomain(email) {
  const isTeacher = email.endsWith('@eduverse.profe.com');
  const isStudent = email.endsWith('@eduverse.alumno.com');
  if (!isTeacher && !isStudent) {
    showToast('Solo se permiten cuentas @eduverse.profe.com o @eduverse.alumno.com', 'error');
    return false;
  }
  return true;
}

function getRoleFromEmail(email) {
  if (email.endsWith('@eduverse.profe.com')) return 'teacher';
  if (email.endsWith('@eduverse.alumno.com')) return 'student';
  return null;
}

function handleLogin() {
  const e = document.getElementById('loginEmail').value.trim();
  const p = document.getElementById('loginPassword').value;
  if (!e || !p) return showToast('Completa todos los campos', 'error');
  if (!checkDomain(e)) return;
  auth.signInWithEmailAndPassword(e, p).catch(err => showToast(err.message, 'error'));
}

function handleRegister() {
  const e = document.getElementById('loginEmail').value.trim();
  const p = document.getElementById('loginPassword').value;
  if (!e || !p) return showToast('Completa todos los campos', 'error');
  if (!e.endsWith('@eduverse.profe.com')) return showToast('El registro solo está disponible para profesores (@eduverse.profe.com)', 'error');
  if (p.length < 6) return showToast('Mínimo 6 caracteres', 'error');
  
  auth.createUserWithEmailAndPassword(e, p).then(cred => {
    return db.collection('users').doc(cred.user.uid).set({
      uid: cred.user.uid, name: e.split('@')[0], email: e, role: 'teacher', avatar: '👨‍',
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
  }).then(() => showToast('Cuenta de profesor creada', 'success')).catch(err => showToast(err.message, 'error'));
}

auth.onAuthStateChanged(user => {
  if (user) {
    currentUser = user;
    const role = getRoleFromEmail(user.email);
    if (!role) { showToast('Correo no válido', 'error'); auth.signOut(); return; }

    db.collection('users').doc(user.uid).get().then(doc => {
      if (doc.exists) {
        userData = doc.data();
        if (userData.role === 'teacher') loadMyClasses();
        else loadStudentClasses();
      } else {
        const newData = { uid: user.uid, name: user.email.split('@')[0], email: user.email, role: role, avatar: role === 'teacher' ? '👨‍' : getRandomAvatar(), classIds: [], createdAt: firebase.firestore.FieldValue.serverTimestamp() };
        db.collection('users').doc(user.uid).set(newData);
        userData = newData;
        if (role === 'teacher') loadMyClasses();
        else loadStudentClasses();
      }
    });
  } else {
    currentUser = null; userData = null; currentClass = null;
    document.getElementById('loginScreen').classList.remove('hidden');
    document.getElementById('appScreen').classList.add('hidden');
    cleanupListeners();
  }
});

function loadMyClasses() {
  db.collection('classes').where('teacherId', '==', currentUser.uid).onSnapshot(snap => {
    myClasses = [];
    snap.forEach(doc => myClasses.push({ id: doc.id, ...doc.data() }));
    updateClassSelector();
    
    document.getElementById('loginScreen').classList.add('hidden');
    document.getElementById('appScreen').classList.remove('hidden');
    updateSidebar();
    showTeacherDashboard();
  });
}

function loadStudentClasses() {
  document.getElementById('loginScreen').classList.add('hidden');
  document.getElementById('appScreen').classList.remove('hidden');
  updateSidebar();
  document.getElementById('classCodeBox').classList.add('hidden');
  document.getElementById('classSelectorContainer').classList.add('hidden');

  const classIds = userData.classIds || [];
  if (classIds.length > 0) {
    const promises = classIds.map(id => db.collection('classes').doc(id).get());
    Promise.all(promises).then(docs => {
      studentClasses = docs.filter(d => d.exists).map(d => ({ id: d.id, ...d.data() }));
      if (studentClasses.length > 0) {
        showStudentDashboard();
      } else {
        document.getElementById('mainContent').innerHTML = `<div class="empty-state"><div class="icon">⏳</div><h3>Esperando asignación</h3><p>Tus profesores aún no te han añadido a ninguna clase.</p></div>`;
      }
    });
  } else {
    document.getElementById('mainContent').innerHTML = `<div class="empty-state"><div class="icon">⏳</div><h3>Esperando asignación</h3><p>Tus profesores aún no te han añadido a ninguna clase.</p></div>`;
  }
}

function showStudentDashboard() {
  const content = document.getElementById('mainContent');
  content.innerHTML = `
    <h1 class="section-title">📚 Mis Clases</h1>
    <p style="color:var(--text-light);margin-bottom:20px;">Bienvenido, ${userData.name}. Estas son tus clases asignadas.</p>
    <div class="classes-grid">
      ${studentClasses.map(c => `
        <div class="class-card" onclick="enterStudentClass('${c.id}')">
          <div class="class-card-header"><div class="class-card-icon">📚</div><div class="class-card-code">${c.code}</div></div>
          <div class="class-card-name">${c.name}</div>
          <div style="font-size:12px;color:var(--text-light);">Profesor: ${c.teacherName}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function enterStudentClass(classId) {
  currentClass = studentClasses.find(c => c.id === classId);
  if (!currentClass) return;
  document.getElementById('classCodeBox').classList.remove('hidden');
  document.getElementById('classCodeDisplay').textContent = currentClass.code;
  cleanupListeners();
  enterClassroom();
}

function updateClassSelector() {
  const sel = document.getElementById('classSelector'), container = document.getElementById('classSelectorContainer');
  if (userData?.role !== 'teacher' || myClasses.length === 0) { container.classList.add('hidden'); return; }
  container.classList.remove('hidden');
  sel.innerHTML = myClasses.map(c => `<option value="${c.id}" ${currentClass?.id === c.id ? 'selected' : ''}>${c.name}</option>`).join('');
}

function createClass() {
  const name = document.getElementById('newClassName').value.trim(), desc = document.getElementById('newClassDesc').value.trim();
  if (!name) return showToast('Nombre obligatorio', 'error');
  const code = generateClassCode();
  const classData = { teacherId: currentUser.uid, teacherName: userData.name, code, name, description: desc, createdAt: firebase.firestore.FieldValue.serverTimestamp() };
  db.collection('classes').add(classData).then(() => {
    closeModal('createClassModal');
    document.getElementById('newClassName').value = '';
    document.getElementById('newClassDesc').value = '';
    showToast('Clase creada: ' + code, 'success');
  });
}

function switchClass(classId) {
  currentClass = myClasses.find(c => c.id === classId);
  if (!currentClass) return;
  document.getElementById('classSelector').value = classId;
  cleanupListeners();
  enterClassroom();
}

function enterClassroom() {
  document.getElementById('classCodeDisplay').textContent = currentClass.code;
  updateSidebar();
  if (userData.role === 'student') document.getElementById('classCodeBox').classList.add('hidden');
  else document.getElementById('classCodeBox').classList.remove('hidden');
  
  loadStudents(); loadMessages(); loadAnnouncements(); loadAssignments(); loadMaterials();
  showSection('students');
}

function updateSidebar() {
  if (!userData) return;
  document.getElementById('sidebarName').textContent = userData.name || 'Usuario';
  document.getElementById('sidebarRole').textContent = userData.role === 'teacher' ? '👨‍🏫 Profesor' : '👨‍🎓 Alumno';
  const avatarEl = document.getElementById('sidebarAvatar');
  if (userData.photoURL) avatarEl.innerHTML = `<img src="${userData.photoURL}">`;
  else avatarEl.textContent = userData.avatar || (userData.name ? userData.name.charAt(0).toUpperCase() : 'U');
}

function showTeacherDashboard() {
  const content = document.getElementById('mainContent');
  content.innerHTML = `
    <h1 class="section-title">🏫 Mis Clases</h1>
    <p style="color:var(--text-light);margin-bottom:20px;">Crea nuevas clases y gestiona a tus alumnos desde aquí.</p>
    <div class="classes-grid">
      <div class="class-card create-class-card" onclick="openModal('createClassModal')">
        <div class="plus">+</div><div class="label">Crear Nueva Clase</div>
      </div>
      ${myClasses.map(c => `
        <div class="class-card" onclick="switchClass('${c.id}')">
          <div class="class-card-header"><div class="class-card-icon"></div><div class="class-card-code">${c.code}</div></div>
          <div class="class-card-name">${c.name}</div>
          ${c.description ? `<div style="font-size:12px;color:var(--text-light);margin-bottom:8px;">${c.description}</div>` : ''}
        </div>
      `).join('')}
    </div>
  `;
}

function loadStudents() {
  if (studentsUnsub) studentsUnsub();
  studentsUnsub = db.collection('classes').doc(currentClass.id).collection('students').orderBy('points', 'desc').onSnapshot(snap => {
    students = []; snap.forEach(doc => students.push({ id: doc.id, ...doc.data() }));
    document.getElementById('studentCount').textContent = students.filter(s => s.role !== 'teacher').length;
    if (currentSection === 'students') renderStudents();
  });
}

function renderStudents() {
  const content = document.getElementById('mainContent');
  const regStudents = students.filter(s => s.role !== 'teacher');
  const totalPoints = regStudents.reduce((s, st) => s + (st.points || 0), 0);
  
  content.innerHTML = `
    <h1 class="section-title">👥 Gestión de Alumnos</h1>
    <div class="stats-bar">
      <div class="stat-card"><div class="stat-value">${regStudents.length}</div><div class="stat-label">Alumnos</div></div>
      <div class="stat-card"><div class="stat-value">${totalPoints}</div><div class="stat-label">Puntos Totales</div></div>
      <div class="stat-card"><div class="stat-value">${regStudents.length > 0 ? Math.round(totalPoints / regStudents.length) : 0}</div><div class="stat-label">Promedio</div></div>
    </div>
    ${userData.role === 'teacher' ? `<button class="btn btn-primary btn-small" style="margin-bottom:20px;" onclick="openAddStudentModal()">➕ Añadir Alumno</button>` : ''}
    
    <h3 style="margin-bottom:10px;font-size:16px;">✅ Alumnos de esta clase</h3>
    <div class="students-grid">
      ${regStudents.map(s => `
        <div class="student-card">
          <div class="avatar large">${s.avatar || s.name.charAt(0).toUpperCase()}</div>
          <div class="student-name">${s.name}</div>
          <div class="student-email">${s.email}</div>
          <span class="points-badge ${s.points < 0 ? 'negative' : ''}">${s.points || 0} pts</span>
          ${userData.role === 'teacher' ? `<div class="student-actions"><button class="point-btn plus" onclick="changePoints('${s.id}', 1)">+</button><button class="point-btn minus" onclick="changePoints('${s.id}', -1)">-</button></div>` : ''}
        </div>
      `).join('')}
    </div>
  `;
}

function openAddStudentModal() {
  document.getElementById('searchStudentEmail').value = '';
  document.getElementById('searchResults').innerHTML = '';
  openModal('addStudentModal');
}

async function searchStudent() {
  const email = document.getElementById('searchStudentEmail').value.trim().toLowerCase();
  const resultsDiv = document.getElementById('searchResults');
  
  if (email.length < 3 || !email.endsWith('@eduverse.alumno.com')) {
    resultsDiv.innerHTML = '';
    return;
  }
  
  try {
    const snap = await db.collection('users').where('email', '==', email).where('role', '==', 'student').get();
    
    if (snap.empty) {
      resultsDiv.innerHTML = '<div style="padding:10px;color:var(--text-light);font-size:13px;">No se encontró ningún alumno con ese correo.</div>';
      return;
    }
    
    const student = snap.docs[0].data();
    const isAlreadyInClass = students.some(s => s.id === student.uid);
    
    resultsDiv.innerHTML = `
      <div class="search-result ${isAlreadyInClass ? '' : ''}" onclick="${isAlreadyInClass ? '' : `addToClass('${student.uid}')`}">
        <div class="avatar medium">${student.avatar || student.name.charAt(0).toUpperCase()}</div>
        <div style="flex:1;">
          <div style="font-weight:600;font-size:14px;">${student.name}</div>
          <div style="font-size:12px;color:var(--text-light);">${student.email}</div>
        </div>
        ${isAlreadyInClass ? '<span style="color:var(--success);font-size:12px;font-weight:600;">✓ Ya está en la clase</span>' : '<button class="btn btn-primary btn-small">Añadir</button>'}
      </div>
    `;
  } catch (err) {
    resultsDiv.innerHTML = '<div style="padding:10px;color:var(--danger);font-size:13px;">Error al buscar: ' + err.message + '</div>';
  }
}

async function addToClass(studentUid) {
  try {
    const studentDoc = await db.collection('users').doc(studentUid).get();
    if (!studentDoc.exists) return showToast('Alumno no encontrado', 'error');
    
    const studentData = studentDoc.data();
    const classIds = studentData.classIds || [];
    
    if (classIds.includes(currentClass.id)) {
      return showToast('El alumno ya está en esta clase', 'warning');
    }
    
    const batch = db.batch();
    
    batch.set(db.collection('classes').doc(currentClass.id).collection('students').doc(studentUid), {
      uid: studentUid,
      name: studentData.name,
      email: studentData.email,
      role: 'student',
      avatar: studentData.avatar || getRandomAvatar(),
      points: 0,
      addedAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    
    batch.update(db.collection('users').doc(studentUid), {
      classIds: firebase.firestore.FieldValue.arrayUnion(currentClass.id)
    });
    
    await batch.commit();
    showToast('Alumno añadido a la clase', 'success');
    closeModal('addStudentModal');
  } catch (err) {
    showToast('Error: ' + err.message, 'error');
  }
}

function changePoints(studentId, amount) {
  const student = students.find(s => s.id === studentId);
  if (!student) return;
  db.collection('classes').doc(currentClass.id).collection('students').doc(studentId).update({ points: firebase.firestore.FieldValue.increment(amount) })
    .then(() => showToast(`${amount > 0 ? '+' : ''}${amount} punto a ${student.name}`, 'success'));
}

function cleanupListeners() {
  if (studentsUnsub) studentsUnsub();
  if (messagesUnsub) messagesUnsub();
  if (announcementsUnsub) announcementsUnsub();
  if (assignmentsUnsub) assignmentsUnsub();
  if (materialsUnsub) materialsUnsub();
}

function loadMessages() {
  if (messagesUnsub) messagesUnsub();
  messagesUnsub = db.collection('classes').doc(currentClass.id).collection('messages').orderBy('timestamp', 'asc').onSnapshot(snap => {
    messages = []; snap.forEach(doc => messages.push({ id: doc.id, ...doc.data() }));
    if (currentSection !== 'chat') { unreadMessages++; const b = document.getElementById('chatBadge'); b.textContent = unreadMessages; b.classList.remove('hidden'); }
  });
}

function loadAnnouncements() {
  if (announcementsUnsub) announcementsUnsub();
  announcementsUnsub = db.collection('classes').doc(currentClass.id).collection('announcements').orderBy('timestamp', 'desc').onSnapshot(snap => {
    announcements = []; snap.forEach(doc => announcements.push({ id: doc.id, ...doc.data() }));
    if (currentSection === 'announcements') renderAnnouncements();
  });
}

function loadAssignments() {
  if (assignmentsUnsub) assignmentsUnsub();
  assignmentsUnsub = db.collection('classes').doc(currentClass.id).collection('assignments').orderBy('createdAt', 'desc').onSnapshot(snap => {
    assignments = []; snap.forEach(doc => assignments.push({ id: doc.id, ...doc.data() }));
    loadSubmissionsForAll();
  });
}

function loadSubmissionsForAll() {
  submissions = [];
  if (assignments.length === 0) { pendingTasks = 0; updateTaskBadge(); if (currentSection === 'assignments') renderAssignments(); return; }
  let loaded = 0;
  assignments.forEach(a => {
    db.collection('classes').doc(currentClass.id).collection('assignments').doc(a.id).collection('submissions').onSnapshot(snap => {
      const subs = []; snap.forEach(doc => subs.push({ id: doc.id, assignmentId: a.id, ...doc.data() }));
      submissions = submissions.filter(s => s.assignmentId !== a.id).concat(subs);
      loaded++;
      if (loaded === assignments.length) {
        const mySubs = submissions.filter(s => s.studentId === currentUser.uid);
        pendingTasks = assignments.filter(a => !mySubs.find(s => s.assignmentId === a.id)).length;
        updateTaskBadge();
        if (currentSection === 'assignments') renderAssignments();
      }
    });
  });
}

function updateTaskBadge() {
  const b = document.getElementById('taskBadge');
  if (pendingTasks > 0 && userData?.role === 'student') { b.textContent = pendingTasks; b.classList.remove('hidden'); } else b.classList.add('hidden');
}

function loadMaterials() {
  if (materialsUnsub) materialsUnsub();
  materialsUnsub = db.collection('classes').doc(currentClass.id).collection('materials').orderBy('createdAt', 'desc').onSnapshot(snap => {
    materials = []; snap.forEach(doc => materials.push({ id: doc.id, ...doc.data() }));
    if (currentSection === 'materials') renderMaterials();
  });
}

function showSection(section, event) {
  currentSection = section;
  document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
  if (event?.target) event.target.closest('.nav-item')?.classList.add('active');
  if (section === 'chat') { unreadMessages = 0; document.getElementById('chatBadge').classList.add('hidden'); }
  if (section === 'students') renderStudents();
  else if (section === 'chat') renderChat();
  else if (section === 'announcements') renderAnnouncements();
  else if (section === 'assignments') renderAssignments();
  else if (section === 'materials') renderMaterials();
}

function renderChat() {
  const content = document.getElementById('mainContent');
  content.innerHTML = `<h1 class="section-title"> Chat</h1><div class="chat-container"><div class="chat-header"><div class="avatar medium">${currentClass.name.charAt(0).toUpperCase()}</div><div><div style="font-weight:600;">${currentClass.name}</div></div></div><div class="chat-messages" id="chatMessages">${messages.length === 0 ? '<div class="empty-state"><div class="icon">💬</div><h3>Sin mensajes</h3></div>' : ''}${messages.map(m => { const isOwn = m.authorId === currentUser.uid; const time = m.timestamp ? m.timestamp.toDate().toLocaleTimeString('es-ES', {hour:'2-digit',minute:'2-digit'}) : ''; return `<div class="message ${isOwn ? 'own' : ''}"><div class="avatar small">${m.authorAvatar || (m.authorName ? m.authorName.charAt(0).toUpperCase() : '?')}</div><div class="message-content"><div class="message-author">${m.authorName || 'Desconocido'} ${m.authorRole === 'teacher' ? '👨🏫' : ''}</div><div class="message-bubble">${escapeHtml(m.text)}</div><div class="message-time">${time}</div></div></div>`; }).join('')}</div><div class="chat-input-container"><input type="text" class="chat-input" id="chatInput" placeholder="Escribe..." onkeypress="if(event.key==='Enter')sendMessage()"><button class="btn-send" onclick="sendMessage()"><svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg></button></div></div>`;
  setTimeout(() => { const c = document.getElementById('chatMessages'); if (c) c.scrollTop = c.scrollHeight; }, 100);
}

function sendMessage() {
  const input = document.getElementById('chatInput'), text = input.value.trim();
  if (!text) return;
  db.collection('classes').doc(currentClass.id).collection('messages').add({ authorId: currentUser.uid, authorName: userData.name, authorAvatar: userData.avatar, authorRole: userData.role, text, timestamp: firebase.firestore.FieldValue.serverTimestamp() }).then(() => input.value = '');
}

function renderAnnouncements() {
  const content = document.getElementById('mainContent');
  content.innerHTML = `<h1 class="section-title"> Anuncios</h1>${userData.role === 'teacher' ? `<button class="btn btn-primary btn-small" style="margin-bottom:15px;" onclick="openModal('announcementModal')">+ Nuevo</button>` : ''}${announcements.length === 0 ? '<div class="empty-state"><div class="icon">📢</div><h3>Sin anuncios</h3></div>' : ''}${announcements.map(a => { const time = a.timestamp ? a.timestamp.toDate().toLocaleString('es-ES', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : ''; return `<div class="announcement"><div class="announcement-header"><div class="announcement-author">‍🏫 ${a.authorName || 'Profesor'}</div><div class="announcement-time">${time}</div></div><div class="announcement-text">${escapeHtml(a.text)}</div></div>`; }).join('')}`;
}

function postAnnouncement() {
  const text = document.getElementById('announcementText').value.trim();
  if (!text) return showToast('Escribe un mensaje', 'error');
  db.collection('classes').doc(currentClass.id).collection('announcements').add({ authorId: currentUser.uid, authorName: userData.name, text, timestamp: firebase.firestore.FieldValue.serverTimestamp() }).then(() => { closeModal('announcementModal'); document.getElementById('announcementText').value = ''; showToast('Publicado', 'success'); });
}

function renderAssignments() {
  const content = document.getElementById('mainContent');
  const mySubs = submissions.filter(s => s.studentId === currentUser.uid);
  content.innerHTML = `<h1 class="section-title">📝 Tareas</h1>${userData.role === 'teacher' ? `<button class="btn btn-primary btn-small" style="margin-bottom:15px;" onclick="openCreateAssignment()">+ Nueva Tarea</button>` : ''}${assignments.length === 0 ? '<div class="empty-state"><div class="icon"></div><h3>Sin tareas</h3></div>' : ''}${assignments.map(a => { const mySub = mySubs.find(s => s.assignmentId === a.id); const subCount = submissions.filter(s => s.assignmentId === a.id).length; const studentCount = students.filter(s => s.role !== 'teacher').length; const dueDate = a.dueDate ? new Date(a.dueDate) : null; const isOverdue = dueDate && dueDate < new Date(); const statusClass = mySub ? (mySub.grade !== undefined && mySub.grade !== null ? 'graded' : 'submitted') : (isOverdue ? 'overdue' : ''); const dueStr = dueDate ? dueDate.toLocaleDateString('es-ES', {day:'2-digit',month:'short',year:'numeric'}) : 'Sin fecha'; return `<div class="assignment-card ${statusClass}"><div class="assignment-header"><div class="assignment-title">${a.title}</div><div class="assignment-due ${isOverdue && !mySub ? 'urgent' : ''}">📅 ${dueStr}${isOverdue && !mySub ? ' (VENCIDA)' : ''}</div></div>${a.description ? `<div class="assignment-desc">${escapeHtml(a.description)}</div>` : ''}<div class="assignment-meta"><span>🎯 ${a.maxPoints || 100} pts</span><span> ${subCount}/${studentCount} entregas</span>${mySub ? `<span class="status-badge status-${mySub.grade !== undefined && mySub.grade !== null ? 'graded' : 'submitted'}">${mySub.grade !== undefined && mySub.grade !== null ? '✅ Calificada: ' + mySub.grade + '/' + a.maxPoints : '📤 Entregada'}</span>` : '<span class="status-badge status-pending"> Pendiente</span>'}</div>${a.fileUrl ? `<div style="margin-bottom:10px;"><a href="${a.fileUrl}" target="_blank" class="btn btn-info btn-small" style="text-decoration:none;">📎 Descargar</a></div>` : ''}<div class="assignment-actions">${userData.role === 'student' && !mySub ? `<button class="btn btn-primary btn-small" onclick="openSubmitAssignment('${a.id}')">📤 Entregar</button>` : ''}${userData.role === 'student' && mySub ? `<button class="btn btn-outline btn-small" onclick="viewMySubmission('${a.id}')">👁️ Ver</button>` : ''}${userData.role === 'teacher' ? `<button class="btn btn-info btn-small" onclick="viewSubmissions('${a.id}')">📋 Ver (${subCount})</button><button class="btn btn-danger btn-small" onclick="deleteAssignment('${a.id}')">🗑️</button>` : ''}</div></div>`; }).join('')}`;
}

function openCreateAssignment() { selectedAssignFile = null; document.getElementById('assignTitle').value = ''; document.getElementById('assignDesc').value = ''; document.getElementById('assignDue').value = ''; document.getElementById('assignMaxPoints').value = '100'; document.getElementById('assignFileName').textContent = 'Ninguno'; document.getElementById('assignFile').value = ''; openModal('createAssignmentModal'); }
function handleAssignFile(e) { const f = e.target.files[0]; if (!f) return; if (f.size > 5 * 1024 * 1024) return showToast('Máximo 5MB', 'error'); selectedAssignFile = f; document.getElementById('assignFileName').textContent = f.name; }
async function createAssignment() {
  const title = document.getElementById('assignTitle').value.trim(), desc = document.getElementById('assignDesc').value.trim();
  const due = document.getElementById('assignDue').value, maxPts = parseInt(document.getElementById('assignMaxPoints').value) || 100;
  if (!title) return showToast('Título obligatorio', 'error');
  let fileUrl = null, fileName = null;
  if (selectedAssignFile) {
    const fd = new FormData(); fd.append('image', selectedAssignFile);
    const res = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) { fileUrl = data.data.url; fileName = selectedAssignFile.name; } else return showToast('Error al subir', 'error');
  }
  db.collection('classes').doc(currentClass.id).collection('assignments').add({ title, description: desc, dueDate: due || null, maxPoints: maxPts, fileUrl, fileName, createdBy: currentUser.uid, createdByName: userData.name, createdAt: firebase.firestore.FieldValue.serverTimestamp() }).then(() => { closeModal('createAssignmentModal'); showToast('Tarea publicada', 'success'); });
}

function openSubmitAssignment(assignId) {
  currentSubmitAssignmentId = assignId;
  document.getElementById('submitAssignTitle').textContent = assignments.find(x => x.id === assignId).title;
  document.getElementById('submitText').value = ''; document.getElementById('submitFileName').textContent = 'Ninguno'; document.getElementById('submitFile').value = ''; selectedSubmitFile = null;
  openModal('submitAssignmentModal');
}
function handleSubmitFile(e) { const f = e.target.files[0]; if (!f) return; if (f.size > 5 * 1024 * 1024) return showToast('Máximo 5MB', 'error'); selectedSubmitFile = f; document.getElementById('submitFileName').textContent = f.name; }
async function submitAssignment() {
  const text = document.getElementById('submitText').value.trim();
  if (!text && !selectedSubmitFile) return showToast('Escribe algo o adjunta archivo', 'error');
  let fileUrl = null, fileName = null;
  if (selectedSubmitFile) {
    const fd = new FormData(); fd.append('image', selectedSubmitFile);
    const res = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) { fileUrl = data.data.url; fileName = selectedSubmitFile.name; } else return showToast('Error al subir', 'error');
  }
  db.collection('classes').doc(currentClass.id).collection('assignments').doc(currentSubmitAssignmentId).collection('submissions').doc(currentUser.uid).set({ studentId: currentUser.uid, studentName: userData.name, studentAvatar: userData.avatar, text, fileUrl, fileName, submittedAt: firebase.firestore.FieldValue.serverTimestamp() }).then(() => { closeModal('submitAssignmentModal'); showToast('Entrega enviada', 'success'); });
}

function viewMySubmission(assignId) {
  const sub = submissions.find(s => s.assignmentId === assignId && s.studentId === currentUser.uid);
  if (!sub) return;
  const a = assignments.find(x => x.id === assignId);
  alert(`Tarea: ${a.title}\nRespuesta: ${sub.text || '(sin texto)'}\n${sub.fileUrl ? 'Archivo: ' + sub.fileName + '\n' + sub.fileUrl : ''}\nCalificación: ${sub.grade !== undefined && sub.grade !== null ? sub.grade + '/' + a.maxPoints : 'Pendiente'}`);
}

function viewSubmissions(assignId) {
  const a = assignments.find(x => x.id === assignId);
  const subs = submissions.filter(s => s.assignmentId === assignId);
  const list = document.getElementById('submissionsList');
  if (subs.length === 0) { list.innerHTML = '<div class="empty-state"><div class="icon">📭</div><h3>Sin entregas</h3></div>'; }
  else {
    list.innerHTML = subs.map(s => `<div class="submission-card"><div class="avatar small">${s.studentAvatar || (s.studentName ? s.studentName.charAt(0).toUpperCase() : '?')}</div><div class="submission-info"><div class="submission-student">${s.studentName || 'Desconocido'}</div><div style="font-size:12px;margin-top:3px;">${escapeHtml(s.text || '').substring(0, 100)}${s.text && s.text.length > 100 ? '...' : ''}</div>${s.fileUrl ? `<a href="${s.fileUrl}" target="_blank" style="font-size:11px;color:var(--primary);">📎 ${s.fileName || 'Archivo'}</a>` : ''}<div class="submission-time">${s.submittedAt ? s.submittedAt.toDate().toLocaleString('es-ES') : ''}</div></div><div style="display:flex;flex-direction:column;gap:5px;align-items:flex-end;"><input type="number" class="grade-input" value="${s.grade !== undefined && s.grade !== null ? s.grade : ''}" placeholder="Nota" min="0" max="${a.maxPoints}" id="grade-${s.id}"><button class="btn btn-warning btn-small" onclick="gradeSubmission('${assignId}','${s.id}')">Calificar</button></div></div>`).join('');
  }
  openModal('viewSubmissionsModal');
}

function gradeSubmission(assignId, subId) {
  const grade = parseFloat(document.getElementById('grade-' + subId).value);
  if (isNaN(grade)) return showToast('Nota inválida', 'error');
  const a = assignments.find(x => x.id === assignId);
  if (grade < 0 || grade > a.maxPoints) return showToast(`Nota entre 0 y ${a.maxPoints}`, 'error');
  db.collection('classes').doc(currentClass.id).collection('assignments').doc(assignId).collection('submissions').doc(subId).update({ grade, gradedAt: firebase.firestore.FieldValue.serverTimestamp(), gradedBy: userData.name }).then(() => showToast('Calificación guardada', 'success'));
}

function deleteAssignment(assignId) {
  if (!confirm('¿Eliminar tarea y entregas?')) return;
  db.collection('classes').doc(currentClass.id).collection('assignments').doc(assignId).collection('submissions').get().then(snap => {
    const batch = db.batch(); snap.docs.forEach(doc => batch.delete(doc.ref)); return batch.commit();
  }).then(() => db.collection('classes').doc(currentClass.id).collection('assignments').doc(assignId).delete()).then(() => showToast('Eliminada', 'success'));
}

function renderMaterials() {
  const content = document.getElementById('mainContent');
  content.innerHTML = `<h1 class="section-title">📚 Materiales</h1>${userData.role === 'teacher' ? `<button class="btn btn-primary btn-small" style="margin-bottom:15px;" onclick="openModal('uploadMaterialModal')"> Subir</button>` : ''}${materials.length === 0 ? '<div class="empty-state"><div class="icon">📚</div><h3>Sin materiales</h3></div>' : ''}${materials.map(m => { const time = m.createdAt ? m.createdAt.toDate().toLocaleDateString('es-ES') : ''; const ext = m.fileName ? m.fileName.split('.').pop().toUpperCase() : 'FILE'; return `<div class="material-card"><div class="material-icon">📄</div><div class="material-info"><div class="material-name">${m.name}</div><div class="material-size">${ext} · ${m.uploadedBy} · ${time}</div></div><a href="${m.fileUrl}" target="_blank" class="btn btn-info btn-small" style="text-decoration:none;">⬇️</a>${userData.role === 'teacher' ? `<button class="btn btn-danger btn-small" onclick="deleteMaterial('${m.id}')">️</button>` : ''}</div>`; }).join('')}`;
}

function handleMaterialFile(e) { const f = e.target.files[0]; if (!f) return; if (f.size > 5 * 1024 * 1024) return showToast('Máximo 5MB', 'error'); selectedMaterialFile = f; document.getElementById('materialFileName').textContent = f.name; }
async function uploadMaterial() {
  const name = document.getElementById('materialName').value.trim();
  if (!name) return showToast('Nombre obligatorio', 'error');
  if (!selectedMaterialFile) return showToast('Selecciona archivo', 'error');
  const fd = new FormData(); fd.append('image', selectedMaterialFile);
  const res = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, { method: 'POST', body: fd });
  const data = await res.json();
  if (!data.success) return showToast('Error al subir', 'error');
  db.collection('classes').doc(currentClass.id).collection('materials').add({ name, fileUrl: data.data.url, fileName: selectedMaterialFile.name, uploadedBy: userData.name, uploadedById: currentUser.uid, createdAt: firebase.firestore.FieldValue.serverTimestamp() }).then(() => { closeModal('uploadMaterialModal'); showToast('Subido', 'success'); });
}
function deleteMaterial(matId) { if (!confirm('¿Eliminar?')) return; db.collection('classes').doc(currentClass.id).collection('materials').doc(matId).delete().then(() => showToast('Eliminado', 'success')); }

function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
function escapeHtml(text) { const d = document.createElement('div'); d.textContent = text || ''; return d.innerHTML; }
function logout() { auth.signOut(); showToast('Sesión cerrada'); }

document.getElementById('loginPassword')?.addEventListener('keypress', e => { if (e.key === 'Enter') handleLogin(); });
document.querySelectorAll('.modal').forEach(m => m.addEventListener('click', e => { if (e.target === m) m.classList.add('hidden'); }));
</script>
</body>
</html>
